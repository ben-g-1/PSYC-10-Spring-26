    "---\n",
    "title: \"PSYC 10 Final -- Interactive Review\"\n",
    "subtitle: \"PSYC 10 -- Spring 2026\"\n",
    "author:\n",
    "  - name: \"Ben Graul\"\n",
    "    affiliation: \"Department of Psychological and Brain Sciences, Dartmouth College\"\n",
